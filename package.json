{
  "name": "simon-says-game",
  "version": "1.0.0",
  "description": "A classic memory game built with HTML, CSS, and JavaScript. Test your memory by repeating increasingly complex sequences of colors and sounds.",
  "author": "Mustafa Sarwari <mustafa.sarwari@email.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mustafa-sarwari/Simon-Says-Game.git"
  },
  "bugs": {
    "url": "https://github.com/mustafa-sarwari/Simon-Says-Game/issues"
  },
  "homepage": "https://mustafa-sarwari.github.io/Simon-Says-Game/",
  "keywords": [
    "game",
    "memory-game",
    "simon-says",
    "javascript",
    "html5",
    "css3",
    "web-game"
  ],
  "dependencies": {
    "parcel": "^2.15.4"
  },
  "devDependencies": {
    "@parcel/transformer-raw": "^2.15.4",
    "jest": "^29.0.0",
    "jest-puppeteer": "^6.0.0",
    "npm-run-all": "^4.1.5",
    "parcel-bundler": "^1.6.1",
    "puppeteer": "^19.0.0"
  },
  "scripts": {
    "start": "parcel --port=3000 index.html",
    "test": "run-p -r start test:run",
    "test:run": "jest --env=puppeteer",
    "test:1": "run-p -r start test:run:1",
    "test:run:1": "jest --env=puppeteer ./test/us-01.test.js",
    "test:2": "run-p -r start test:run:2",
    "test:run:2": "jest --env=puppeteer ./test/us-02.test.js",
    "test:3": "run-p -r start test:run:3",
    "test:run:3": "jest --env=puppeteer ./test/us-03.test.js",
    "test:4": "run-p -r start test:run:4",
    "test:run:4": "jest --env=puppeteer ./test/us-04.test.js",
    "test:5": "run-p -r start test:run:5",
    "test:run:5": "jest --env=puppeteer ./test/us-05.test.js"
  }
}
